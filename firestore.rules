rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Invite codes ────────────────────────────────────────────────────────
    // Authenticated users can read (to check availability) and claim an unused
    // code by creating the doc. No updates or deletes from clients — codes are
    // single-use and their history is retained even after an account is deleted.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.consumedBy == request.auth.uid
        && request.resource.data.code == code;
      allow update, delete: if false;
    }

    // ── Per-user data ───────────────────────────────────────────────────────
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Bikes subcollection
      match /bikes/{bikeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Components subcollection
      match /components/{componentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Strava tokens subcollection
      match /strava/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Invite codes ────────────────────────────────────────────────────────
    // Authenticated users can read (to check availability) and claim an unused
    // code by creating the doc. No updates or deletes from clients — codes are
    // single-use and their history is retained even after an account is deleted.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.consumedBy == request.auth.uid
        && request.resource.data.code == code;
      allow update, delete: if false;
    }

    // ── Per-user data ───────────────────────────────────────────────────────
    // Users can only access their own data, including everything nested under
    // their /users/{userId} document. The recursive wildcard covers all current
    // subcollections (bikes, components, strava, syncState) and any future
    // ones — Firestore rules don't cascade by default, so without this we'd
    // have to remember to add a new `match` block every time we introduce a
    // subcollection (we shipped the syncState collection without one and
    // silently broke Strava sync as a result).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
